sh <- subjectHits(hits)
cov_vals <- mcols(gr_list[[i]])$coverage[sh]
# aggregate coverage per exon
cov_by_exon <- tapply(cov_vals, qh, mean)
cov_exons_mat[as.integer(names(cov_by_exon)), i] <- cov_by_exon
}
cov_exons_mat
dim(cov_exons_mat)
